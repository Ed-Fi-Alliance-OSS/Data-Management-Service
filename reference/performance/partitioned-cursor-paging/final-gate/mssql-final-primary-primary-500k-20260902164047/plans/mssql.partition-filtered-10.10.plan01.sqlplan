<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4065.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH candidates AS (&#xa;SELECT r.[DocumentId]&#xa;FROM [edfi].[Student] r&#xa;WHERE&#xa;    (r.[BirthDate] = @birthDate)&#xa;),&#xa;ranked AS (&#xa;    SELECT&#xa;        pc.[DocumentId],&#xa;        ROW_NUMBER() OVER (ORDER BY pc.[DocumentId]) AS [row_number],&#xa;        COUNT_BIG(*) OVER () AS [candidate_count]&#xa;    FROM candidates pc&#xa;),&#xa;sized AS (&#xa;    SELECT&#xa;        pr.[DocumentId],&#xa;        pr.[row_number],&#xa;        CASE WHEN CAST(CEILING(CAST(pr.[candidate_count] AS decimal(28,0)) / CAST(@number AS decimal(10,0))) AS bigint) &gt; @minimumPartitionSize THEN CAST(CEILING(CAST(pr.[candidate_count] AS decimal(28,0)) / CAST(@number AS decimal(10,0))) AS bigint) ELSE @minimumPartitionSize END AS [partition_size]&#xa;    FROM ranked pr&#xa;)&#xa;SELECT ps.[DocumentId]&#xa;FROM sized ps&#xa;WHERE (ps.[row_number] - 1) % ps.[partition_size] = 0&#xa;ORDER BY ps.[DocumentId] ASC" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x09004E0500E21A79369CDF90AA65BC5509AB0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="9.29825" StatementEstRows="4997" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x6E87299D7A145EE2" QueryPlanHash="0x26652A96C1358A89" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="16" MemoryGrant="3584" CachedPlanSize="56" CompileTime="2" CompileCPU="2" CompileMemory="504"><ThreadStat Branches="3" UsedThreads="33"><ThreadReservation NodeId="0" ReservedThreads="48"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="78.783"><MissingIndex Database="[dmsfp4a2fa4445e486d54cde]" Schema="[edfi]" Table="[Student]"><ColumnGroup Usage="EQUALITY"><Column Name="[BirthDate]" ColumnId="12"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="0" SerialDesiredMemory="0" RequiredMemory="3584" DesiredMemory="3584" RequestedMemory="3584" GrantWaitTime="0" MaxQueryMemory="2119248" GrantedMemory="3584" MaxUsedMemory="3584"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="81164" EstimatedPagesCached="81164" EstimatedAvailableDegreeOfParallelism="8" MaxCompileMemory="6082992"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-09-02T16:40:27.97" ModificationCount="0" SamplingPercent="13.344" Statistics="[UX_Student_RefKey]" Table="[Student]" Schema="[edfi]" Database="[dmsfp4a2fa4445e486d54cde]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-09-02T16:40:28.12" ModificationCount="0" SamplingPercent="13.344" Statistics="[IX_Student_BirthCountryDescriptor_DescriptorId]" Table="[Student]" Schema="[edfi]" Database="[dmsfp4a2fa4445e486d54cde]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-09-02T16:40:28.07" ModificationCount="0" SamplingPercent="13.344" Statistics="[UX_Student_NK]" Table="[Student]" Schema="[edfi]" Database="[dmsfp4a2fa4445e486d54cde]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-09-02T16:40:28.26" ModificationCount="0" SamplingPercent="13.344" Statistics="[IX_Student_CitizenshipStatusDescriptor_DescriptorId]" Table="[Student]" Schema="[edfi]" Database="[dmsfp4a2fa4445e486d54cde]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-09-02T16:40:28.80" ModificationCount="0" SamplingPercent="13.344" Statistics="[_WA_Sys_0000000C_08AB2BC8]" Table="[Student]" Schema="[edfi]" Database="[dmsfp4a2fa4445e486d54cde]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-09
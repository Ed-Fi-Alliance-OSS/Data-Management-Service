+    /// <summary>
+    /// DMS-1521 inline: the descriptor batch without <c>descriptor_page</c>. The page is selected once,
+    /// into the same carrier the resource keyset uses, so both version fences and the owner rows read
+    /// one selection. PostgreSQL selects the page inside the boundary statement (a one-row aggregate
+    /// that sets the transaction-local carrier and returns the boundary), so the batch gains no result
+    /// set; that moves selection after the count statement. SQL Server fills the JSON batch variable
+    /// where the temp table was filled. The rows read the carrier with no bound parameter.
+    /// </summary>
+    private static RelationalCommand BuildDms1521InlineQueryCommand(
+        SqlDialect dialect,
+        PageKeysetSpec.Query plannedQuery,
+        DescriptorRowProjection projection
+    )
+    {
+        bool anchor = plannedQuery.OrderingMode is PageOrderingMode.ContentVersion;
+        string id = QuoteIdentifier(dialect, "DocumentId");
+        string version = QuoteIdentifier(dialect, "ContentVersion");
+        string boundaryColumn = anchor ? version : id;
+        string highest = QuoteIdentifier(dialect, "HighestSelectedAnchor");
+        string anchorColumn = anchor ? $", {version}" : "";
+        string nullAnchor = anchor ? $", CAST(NULL AS bigint) AS {version}" : "";
+        string selectionSql = HasZeroLimit(plannedQuery)
+            ? $"SELECT CAST(NULL AS bigint) AS {id}{nullAnchor} WHERE 1 = 0"
+            : PlanSqlStatementText.AsEmbeddableBody(plannedQuery.Plan.PageDocumentIdSql);
+        string countSql = plannedQuery.Plan.TotalCountSql is null
+            ? ""
+            : PlanSqlStatementText.AsTerminatedStatement(plannedQuery.Plan.TotalCountSql)
+                + Environment.NewLine;
+
+        string prelude;
+        string pageSql;
+        string boundarySql;
+        if (dialect == SqlDialect.Pgsql)
+        {
+            string carrier = $"current_setting('{Dms1521KeysetVariant.PgsqlCarrierSetting}', true)";
+            prelude = "";
+            pageSql =
+                $"SELECT u.{id} FROM unnest(CAST(string_to_array({carrier}, ',') AS bigint[])) AS u({id})";
+            boundarySql =
+                "-- Descriptor page selection boundary\n"
+                + $"WITH page_ids AS (\n{selectionSql}\n)\n"
+                + $"SELECT c.{highest} FROM (SELECT set_config('{Dms1521KeysetVariant.PgsqlCarrierSetting}', "
+                + $"COALESCE(string_agg(CAST(p.{id} AS text), ',' ORDER BY p.{id}), ''), true) AS keyset, "
+                + $"MAX(p.{boundaryColumn}) AS {highest} FROM page_ids p) c WHERE c.keyset IS NOT NULL;\n";
+        }
+        else
+        {
+            string carrier = Dms1521KeysetVariant.MssqlCarrierVariable;
+            string anchorJson = anchor ? $", {version} bigint '$.ContentVersion'" : "";
+            string openJson = $"OPENJSON({carrier}) WITH ({id} bigint '$.DocumentId'{anchorJson}) kj";
+            string fill = HasZeroLimit(plannedQuery)
+                ? ""
+                : $"WITH page_ids AS (\n{selectionSql}\n)\n"
+                    + $"SELECT {carrier} = (SELECT {id}{anchorColumn} FROM page_ids FOR JSON PATH);\n";
+            prelude = $"DECLARE {carrier} nvarchar(max);\n" + fill;
+            pageSql = $"SELECT kj.{id} FROM {openJson}";
+            boundarySql =
+                $"-- Descriptor page selection boundary\nSELECT MAX(kj.{boundaryColumn}) AS {highest} FROM {openJson};\n";
+        }
+
+        string versionSql = BuildPageRowsSql(dialect, pageSql, DescriptorRowProjection.DocumentVersions);
+        string pageRowsSql = BuildPageRowsSql(dialect, pageSql, projection);
+        return new RelationalCommand(
+            prelude + countSql + boundarySql + BuildAcquisitionSql(versionSql, pageRowsSql),
+            BuildQueryParameters(plannedQuery)
+        );
+    }

+    /// <summary>
+    /// DMS-1521 inline keyset: the keyset relation as a derived table over the in-batch carrier, with the
+    /// keyset table's columns (<c>DocumentId</c>, <c>Ordinal</c>). PostgreSQL reads the bound
+    /// <c>bigint[]</c> of a selected page, or, when it is NULL (a query keyset), the transaction-local
+    /// carrier setting; a query keyset keeps a NULL ordinal. SQL Server reads the <c>@page_keyset</c>
+    /// JSON batch variable, whose objects omit <c>Ordinal</c> for a query keyset.
+    /// </summary>
+    private static SqlWriter AppendDms1521InlineKeyset(SqlWriter writer)
+    {
+        string documentId = writer.Dialect.QuoteIdentifier("DocumentId");
+        string ordinal = writer.Dialect.QuoteIdentifier(
+            HydrationSqlConventions.SelectedPageOrdinalColumnName
+        );
+
+        if (writer.Dialect.Rules.Dialect is SqlDialect.Mssql)
+        {
+            return writer.Append(
+                $"(SELECT kj.{documentId}, kj.{ordinal} FROM OPENJSON({Dms1521KeysetVariant.MssqlCarrierVariable}) "
+                    + $"WITH ({documentId} bigint '$.DocumentId', {ordinal} int '$.Ordinal') kj)"
+            );
+        }
+
+        string ids = $"CAST(@{Dms1521KeysetVariant.PgsqlDocumentIdsParameterName} AS bigint[])";
+        return writer.Append(
+            $"(SELECT u.{documentId}, CASE WHEN {ids} IS NULL THEN NULL ELSE CAST(u.{ordinal} - 1 AS int) END AS {ordinal} "
+                + $"FROM unnest(COALESCE({ids}, CAST(string_to_array(current_setting('{Dms1521KeysetVariant.PgsqlCarrierSetting}', true), ',') AS bigint[]))) "
+                + $"WITH ORDINALITY AS u({documentId}, {ordinal}))"
+        );
+    }

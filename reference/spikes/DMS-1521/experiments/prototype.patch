+    /// <summary>
+    /// DMS-1521 inline keyset materialization. A query keyset selects the page once and returns its
+    /// selected keys as the batch's first result set (same position and shape as the temp-table
+    /// materialization), while storing them in the in-batch carrier: a transaction-local setting on
+    /// PostgreSQL, set through a one-row aggregate so it is set (or cleared, for an empty page) before
+    /// any later statement reads it; a JSON batch variable on SQL Server. A selected page or single
+    /// document emits nothing on PostgreSQL (its ids are the bound <c>bigint[]</c>) and declares the
+    /// carrier from its existing JSON parameter on SQL Server.
+    /// </summary>
+    private static void AppendDms1521InlineMaterialization(
+        SqlWriter writer,
+        PageKeysetSpec spec,
+        string? singleRowGuardPredicateSql = null
+    )
+    {
+        bool mssql = writer.Dialect.Rules.Dialect is SqlDialect.Mssql;
+        string id = writer.Dialect.QuoteIdentifier("DocumentId");
+        string anchor = writer.Dialect.QuoteIdentifier(HydrationSqlConventions.SelectedAnchorColumnName);
+        string carrier = Dms1521KeysetVariant.MssqlCarrierVariable;
+
+        switch (spec)
+        {
+            case PageKeysetSpec.Single when singleRowGuardPredicateSql is not null:
+                throw new NotSupportedException(
+                    "DMS-1521 inline prototype: a guarded single-document keyset needs the single-document fast path."
+                );
+
+            case PageKeysetSpec.Single:
+                if (mssql)
+                {
+                    writer
+                        .Append($"DECLARE {carrier} nvarchar(max) = (SELECT CAST(")
+                        .AppendParameter(HydrationSqlConventions.SingleDocumentIdParameterName)
+                        .AppendLine($" AS bigint) AS {id} FOR JSON PATH);");
+                }
+                return;
+
+            case PageKeysetSpec.SelectedPage selectedPage:
+                if (mssql)
+                {
+                    writer.Append($"DECLARE {carrier} nvarchar(max) = ");
+                    if (selectedPage.DocumentIds.Count == 0)
+                    {
+                        writer.Append("NULL");
+                    }
+                    else
+                    {
+                        writer.AppendParameter(
+                            HydrationSqlConventions.SelectedPageDocumentIdsJsonParameterName
+                        );
+                    }
+                    writer.AppendLine(";");
+                }
+                return;
+
+            case PageKeysetSpec.Query query:
+                bool carriesAnchor = CarriesSelectedAnchor(query);
+                string columns = carriesAnchor ? $"{id}, {anchor}" : id;
+                string nullAnchor = carriesAnchor ? $", CAST(NULL AS bigint) AS {anchor}" : "";
+                string pageSql = HasZeroPageSelectionSize(query)
+                    ? $"SELECT CAST(NULL AS bigint) AS {id}{nullAnchor} WHERE 1 = 0"
+                    : PlanSqlStatementText.AsEmbeddableBody(query.Plan.PageDocumentIdSql);
+
+                if (mssql)
+                {
+                    writer
+                        .AppendLine($"DECLARE {carrier} nvarchar(max);")
+                        .AppendLine("WITH page_ids AS (")
+                        .AppendLine(pageSql)
+                        .AppendLine(")")
+                        .AppendLine($"SELECT {carrier} = (SELECT {columns} FROM page_ids FOR JSON PATH);")
+                        .Append($"SELECT k.{id}")
+                        .Append(carriesAnchor ? $", k.{anchor}" : "")
+                        .Append($" FROM OPENJSON({carrier}) WITH ({id} bigint '$.DocumentId'")
+                        .Append(carriesAnchor ? $", {anchor} bigint '$.ContentVersion'" : "")
+                        .AppendLine(") k;");
+                    return;
+                }
+
+                writer
+                    .AppendLine("WITH page_ids AS (")
+                    .AppendLine(pageSql)
+                    .AppendLine(")")
+                    .Append($"SELECT u.{id}")
+                    .AppendLine(carriesAnchor ? $", u.{anchor}" : "")
+                    .Append(
+                        $"FROM (SELECT set_config('{Dms1521KeysetVariant.PgsqlCarrierSetting}', "
+                            + $"COALESCE(string_agg(CAST(p.{id} AS text), ',' ORDER BY p.{id}), ''), true) AS keyset"
+                    )
+                    .Append(carriesAnchor ? $", array_agg(p.{anchor} ORDER BY p.{id}) AS anchors" : "")
+                    .AppendLine(" FROM page_ids p) c")
+                    .Append("CROSS JOIN LATERAL unnest(CAST(string_to_array(c.keyset, ',') AS bigint[])")
+                    .Append(carriesAnchor ? ", c.anchors" : "")
+                    .Append($") AS u({id}")
+                    .Append(carriesAnchor ? $", {anchor}" : "")
+                    .AppendLine(");");
+                return;
+
+            default:
+                throw new ArgumentOutOfRangeException(
+                    nameof(spec),
+                    spec,
+                    "Unexpected PageKeysetSpec variant."
+                );
+        }
+    }

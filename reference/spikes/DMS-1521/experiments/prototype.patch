+namespace EdFi.DataManagementService.Backend.Plans;
+
+/// <summary>
+/// DMS-1521 spike only (reference/spikes/DMS-1521/experiments/prototype.patch). Selects the keyset
+/// variant from <c>DMS1521_KEYSET_VARIANT</c>, read once per process; unset means <c>baseline</c>,
+/// which leaves every batch byte-identical to main.
+/// </summary>
+public static class Dms1521KeysetVariant
+{
+    public const string Baseline = "baseline";
+    public const string PgAnalyze = "pg-analyze";
+    public const string InlineValue = "inline";
+
+    /// <summary>PostgreSQL transaction-local setting that carries a query keyset's selected ids.</summary>
+    public const string PgsqlCarrierSetting = "dms.page_keyset";
+
+    /// <summary>
+    /// PostgreSQL <c>bigint[]</c> parameter every keyset relation reads. A selected page (or single
+    /// document) binds its ids; a query keyset binds NULL and the relation reads the carrier instead.
+    /// </summary>
+    public const string PgsqlDocumentIdsParameterName = "page_document_ids";
+
+    /// <summary>SQL Server batch variable that carries the keyset as JSON.</summary>
+    public const string MssqlCarrierVariable = "@page_keyset";
+
+    public static string Value { get; } = Read();
+
+    /// <summary>
+    /// PostgreSQL only: analyze the keyset temp table right after it is materialized, so the statements
+    /// that join it are planned with its real row count.
+    /// </summary>
+    public static bool AnalyzePostgresqlKeyset => Value == PgAnalyze;
+
+    /// <summary>Carry the keyset inside the batch instead of a temp table (no catalog object).</summary>
+    public static bool Inline => Value == InlineValue;
+
+    private static string Read()
+    {
+        string value = Environment.GetEnvironmentVariable("DMS1521_KEYSET_VARIANT") is { Length: > 0 } raw
+            ? raw.Trim()
+            : Baseline;
+        return value is Baseline or PgAnalyze or InlineValue
+            ? value
+            : throw new InvalidOperationException($"Unknown DMS1521_KEYSET_VARIANT '{value}'.");
+    }
+}

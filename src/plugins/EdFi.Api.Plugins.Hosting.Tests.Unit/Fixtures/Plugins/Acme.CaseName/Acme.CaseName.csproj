        <AssemblyName>Acme.CaseName</AssemblyName>
        <RootNamespace>Acme.CaseName</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\..\EdFi.Api.Plugins\EdFi.Api.Plugins.csproj" />
    </ItemGroup>
</Project>

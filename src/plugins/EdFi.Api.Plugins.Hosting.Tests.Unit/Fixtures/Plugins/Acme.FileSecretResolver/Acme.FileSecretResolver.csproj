<Project Sdk="Microsoft.NET.Sdk">
    <!--
        A Configuration Service secret resolver backed by a file the end-to-end harness writes, so the
        harness controls what the store holds and when it changes. It reads the file on every call and
        caches nothing, which leaves the host's cache as the only thing deciding how fresh a resolved
        value is. Published framework-dependent and mounted through eng/docker-compose/plugins-config.yml
        by the end-to-end harness; no unit test stages it.
    -->
    <PropertyGroup>
        <AssemblyName>Acme.FileSecretResolver</AssemblyName>
        <RootNamespace>Acme.FileSecretResolver</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\..\EdFi.Api.Plugins\EdFi.Api.Plugins.csproj" />
        <ProjectReference Include="..\..\..\..\..\config\contracts\EdFi.DmsConfigurationService.Secrets\EdFi.DmsConfigurationService.Secrets.csproj" />
    </ItemGroup>
</Project>

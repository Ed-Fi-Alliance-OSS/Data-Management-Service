<Project
    Sdk="Microsoft.NET.Sdk"
    TreatAsLocalProperty="Version;VersionPrefix;AssemblyVersion;FileVersion;InformationalVersion"
>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!--
            Never packaged. The loader that will live here is ordinary host code, and its public
            surface must not become a compatibility commitment to third parties the way the contract
            assembly's is. Both host frontends reference it by project.
        -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\EdFi.Api.Plugins\EdFi.Api.Plugins.csproj" />
    </ItemGroup>
    <!--
        The binder is what turns the Plugins section into PluginsOptions. IConfiguration itself
        arrives from the contract's Microsoft.Extensions.Configuration.Abstractions reference; the
        Get<T> extension lives in the Binder package and is the only reason it is here. It is a host
        assembly dependency and not a contract one, so it places no obligation on a plugin author.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
        <!--
            The configuration phase takes the host's ConfigurationManager, which is declared in the
            configuration package rather than the abstractions, and places plugin sources relative to
            the host's EnvironmentVariablesConfigurationSource, which is the only reason for the second
            reference. Both are host dependencies and place no obligation on a plugin author.
        -->
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
        <!--
            For the four service type names in the logging carve-out, which are all declared here,
            and for ILogger in PluginInventoryLog. The carve-out is written as names rather than as an
            assembly or namespace rule, and the abstractions package carries no implementation. The
            loader and the composition phases log nothing: their channel is Console.Error,
            deliberately, because they run before any logging pipeline exists. PluginInventoryLog is
            the one exception, and it lives here so both hosts emit the inventory in one shape: each
            host calls it once its own logger exists and hands that logger in.
        -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <!--
            The contract's own reference brings this in transitively, and the audit now depends on it
            directly: it resolves service and keyed-service collections from a scope over the container
            the host built, and it names the wildcard service key. A direct dependency is declared
            directly.
        -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>
    <!--
        The loader's collaborators are the filesystem, the dependency manifest, and the runtime's own
        binder, so the types that model them are internal: they are implementation, not a surface a
        host composes against. The unit test project therefore needs access to them to assert the
        rules directly rather than only through what Load happens to expose.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="EdFi.Api.Plugins.Hosting.Tests.Unit" />
        <!--
            The Configuration Service's frontend tests, for the host-owned predicate and the recording
            wrapper against real CMS service types. A refused plugin hook ends the boot before any test
            callback sees the service collection, so whether a refusal left the collection untouched
            can only be shown by driving the wrapper directly.
        -->
        <InternalsVisibleTo Include="EdFi.DmsConfigurationService.Frontend.AspNetCore.Tests.Unit" />
    </ItemGroup>
</Project>

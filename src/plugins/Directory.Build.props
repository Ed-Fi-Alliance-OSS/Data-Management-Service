<Project>
    <!--
        Hand-maintained, and deliberately outside build-dms.ps1's SetDMSAssemblyInfo, which
        regenerates src/dms/Directory.Build.props with the DMS release version on every
        BuildAndPublish. The plugin loader's newer-plugin-on-older-host preflight compares
        AssemblyVersions across contract assemblies, so a contract's version has to move when its
        public surface moves and must not move when it does not. Stamping the DMS release onto this
        tree would make an 8.3 host refuse a plugin built against an identical 8.4 contract, naming
        two versions that differ in nothing an implementer can act on.

        There is no src/Directory.Build.props and a nested Directory.Build.props does not import a
        parent, so src/dms and src/config each carry their own and this third tree inherits nothing
        from either. What follows is the restore-relevant and metadata content of
        src/dms/Directory.Build.props. TargetFramework, Nullable, ImplicitUsings, and
        GenerateDocumentationFile are deliberately absent: they are per-csproj everywhere under
        src/dms. src/dms/Directory.Build.targets is not copied either; it exists to materialize the
        bundled ApiSchema manifest and has no counterpart here.
    -->
    <PropertyGroup>
        <!--
            The first published contract surface: an abstract Name and a virtual ContributeServices.
            Bump the minor when a new virtual member with a no-op body is added, which is the only
            evolution the additive-only compatibility policy allows. A breaking change is a new
            package id, not a major bump, because the default binder would load an older plugin
            against it and fail with MissingMethodException inside a hook.
        -->
        <VersionPrefix>1.0.0</VersionPrefix>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
        <Product>Ed-Fi API</Product>
        <Authors>Ed-Fi Alliance, LLC and contributors</Authors>
        <Company>Ed-Fi Alliance, LLC and contributors</Company>
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <ErrorLog>results.sarif,version=2.1</ErrorLog>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeStyle">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="SonarAnalyzer.CSharp">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
</Project>

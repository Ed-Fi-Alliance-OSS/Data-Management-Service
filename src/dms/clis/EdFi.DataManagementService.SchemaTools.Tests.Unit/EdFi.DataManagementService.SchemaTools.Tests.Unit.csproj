<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="FakeItEasy" />
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NUnit" />
        <PackageReference Include="NUnit3TestAdapter" />
        <PackageReference Include="Microsoft.CodeAnalysis" />
    </ItemGroup>
    <ItemGroup>
        <None
            Include="../EdFi.DataManagementService.SchemaTools.Tests.Integration/Fixtures/minimal-api-schema.json"
            Link="Fixtures/minimal-api-schema.json"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
    <ItemGroup>
        <Compile
            Include="../../backend/EdFi.DataManagementService.Backend.Cdc.Tests.Unit/CdcReadinessTestBase.cs"
            Link="Shared/CdcReadinessTestBase.cs"
        />
        <Compile
            Include="../../backend/EdFi.DataManagementService.Backend.Cdc.Tests.Unit/CdcRegistrationTestBase.cs"
            Link="Shared/CdcRegistrationTestBase.cs"
        />
        <Compile
            Include="../../backend/EdFi.DataManagementService.Backend.Cdc.Tests.Unit/CdcDeploymentRequestTestData.cs"
            Link="Shared/CdcDeploymentRequestTestData.cs"
        />
        <Compile
            Include="../../backend/EdFi.DataManagementService.Backend.Cdc.Tests.Unit/CdcConnectorTemplateTestData.cs"
            Link="Shared/CdcConnectorTemplateTestData.cs"
        />
    </ItemGroup>
    <ItemGroup>
        <Using Include="NUnit.Framework" />
    </ItemGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\EdFi.DataManagementService.SchemaTools\EdFi.DataManagementService.SchemaTools.csproj" />
    </ItemGroup>
</Project>

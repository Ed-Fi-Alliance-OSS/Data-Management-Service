<Project>
    <!--
        Publishes the fixture plugins the host-integration cases load into this project's output as real
        plugin directories. Their sources live beside the plugin hosting tests' own fixtures, because
        that is where fixture plugins live and because that tree carries the props keeping a deliberately
        odd test asset out of the analyzer set; only the staging happens here.

        Two fixtures rather than an import of the hosting project's list, for the reason the frontend
        test project's own staging file records: that list is dozens of directories and publishing all of
        them into a third project's output would lengthen a long build for assets no test here reads.

        Freshness is a recorded fingerprint rather than an Inputs/Outputs comparison against the staged
        files. A publish copies files, a copy carries the source file's modification time, so a staged
        file is routinely older than an input that has just been edited and the comparison would find the
        tree out of date forever.
    -->
    <ItemGroup>
        <PluginIntegrationFixture
            Include="$(MSBuildThisFileDirectory)../../../plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Plugins/Acme.DmsContributor/Acme.DmsContributor.csproj"
        >
            <StagedName>Acme.DmsContributor</StagedName>
        </PluginIntegrationFixture>
        <PluginIntegrationFixture
            Include="$(MSBuildThisFileDirectory)../../../plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Plugins/Acme.DmsHookTouch/Acme.DmsHookTouch.csproj"
        >
            <StagedName>Acme.DmsHookTouch</StagedName>
        </PluginIntegrationFixture>
        <PluginIntegrationFixture
            Include="$(MSBuildThisFileDirectory)../../../plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Plugins/Acme.HookThrows/Acme.HookThrows.csproj"
        >
            <StagedName>Acme.HookThrows</StagedName>
        </PluginIntegrationFixture>
    </ItemGroup>

    <!--
        Everything the staged bytes can depend on, as directories rather than as a hand-written list of
        files, which is the conclusion both existing staging files reached. An enumeration of the files a
        closure happens to reach today silently omits the next one somebody adds. bin/ and obj/ are
        excluded everywhere, because generated sources change on every build and would leave the tree
        permanently out of date.

        $(PluginIntegrationFixtureRepositoryRoot) is this file's directory walked up to src/, so each
        root below is one readable path rather than four parent steps.
    -->
    <PropertyGroup>
        <PluginIntegrationFixtureRepositoryRoot
        >$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..'))</PluginIntegrationFixtureRepositoryRoot>
    </PropertyGroup>

    <ItemGroup>
        <!-- The staging rules themselves. -->
        <PluginIntegrationFixtureInput Include="$(MSBuildThisFileFullPath)" />

        <!--
            Every staged fixture's own directory, and every support project they reference. Written out
            rather than derived from the item list above, because an item transform does not glob:
            '%(Directory)**/*' arrives as one item whose identity is that literal string, so a transform
            here would watch nothing at all.

            A fixture added to the list above therefore needs its directory added here too.
        -->
        <PluginIntegrationFixtureInput
            Include="$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Plugins/Acme.DmsContributor/**/*;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Plugins/Acme.DmsHookTouch/**/*;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Plugins/Acme.HookThrows/**/*;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Support/AcmePrivate/**/*;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Support/AcmeFixtureContracts/**/*"
            Exclude="$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Plugins/Acme.DmsContributor/bin/**;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Plugins/Acme.DmsContributor/obj/**;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Plugins/Acme.DmsHookTouch/bin/**;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Plugins/Acme.DmsHookTouch/obj/**;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Plugins/Acme.HookThrows/bin/**;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Plugins/Acme.HookThrows/obj/**;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Support/AcmePrivate/bin/**;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Support/AcmePrivate/obj/**;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Support/AcmeFixtureContracts/bin/**;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Support/AcmeFixtureContracts/obj/**"
        />

        <!-- The props those fixtures inherit from the fixture tree they sit in. -->
        <PluginIntegrationFixtureInput
            Include="$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Directory.Build.props;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting.Tests.Unit/Fixtures/Directory.Packages.props"
        />

        <!--
            Every production project the fixtures reference, directly or through another of them: the
            plugin contract, the plugin hosting assembly one of them names the audit input from, the
            custom validation contract, the backend repository contract, and the core external contract
            that last one references in turn.
        -->
        <PluginIntegrationFixtureInput
            Include="$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins/**/*;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting/**/*"
            Exclude="$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins/bin/**;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins/obj/**;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting/bin/**;$(PluginIntegrationFixtureRepositoryRoot)plugins/EdFi.Api.Plugins.Hosting/obj/**"
        />
        <PluginIntegrationFixtureInput
            Include="$(PluginIntegrationFixtureRepositoryRoot)dms/core/EdFi.DataManagementService.CustomValidation/**/*;$(PluginIntegrationFixtureRepositoryRoot)dms/core/EdFi.DataManagementService.Core.External/**/*;$(PluginIntegrationFixtureRepositoryRoot)dms/backend/EdFi.DataManagementService.Backend.External/**/*"
            Exclude="$(PluginIntegrationFixtureRepositoryRoot)dms/core/EdFi.DataManagementService.CustomValidation/bin/**;$(PluginIntegrationFixtureRepositoryRoot)dms/core/EdFi.DataManagementService.CustomValidation/obj/**;$(PluginIntegrationFixtureRepositoryRoot)dms/core/EdFi.DataManagementService.Core.External/bin/**;$(PluginIntegrationFixtureRepositoryRoot)dms/core/EdFi.DataManagementService.Core.External/obj/**;$(PluginIntegrationFixtureRepositoryRoot)dms/backend/EdFi.DataManagementService.Backend.External/bin/**;$(PluginIntegrationFixtureRepositoryRoot)dms/backend/EdFi.DataManagementService.Backend.External/obj/**"
        />

        <!--
            The build metadata every one of those inherits: the props each tree carries, the central
            package versions the fixture tree's own props chain to, and the NuGet configuration a restore
            of any of them reads.
        -->
        <PluginIntegrationFixtureInput
            Include="$(PluginIntegrationFixtureRepositoryRoot)Directory.Packages.props;$(PluginIntegrationFixtureRepositoryRoot)nuget.config;$(PluginIntegrationFixtureRepositoryRoot)plugins/Directory.Build.props;$(PluginIntegrationFixtureRepositoryRoot)dms/Directory.Build.props;$(PluginIntegrationFixtureRepositoryRoot)dms/Directory.Build.targets"
        />
    </ItemGroup>

    <Target
        Name="PrunePluginIntegrationFixtureStaging"
        Condition="'$(BuildingPluginFixtures)' != 'true' AND '$(DesignTimeBuild)' != 'true'"
    >
        <PropertyGroup>
            <PluginIntegrationFixtureStageRoot
            >$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '$(OutDir)', 'PluginFixtures'))</PluginIntegrationFixtureStageRoot>
            <PluginIntegrationFixtureStampDir
            >$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '$(IntermediateOutputPath)', 'pluginfixtures'))</PluginIntegrationFixtureStampDir>
            <PluginIntegrationFixtureFingerprintFile
            >$(PluginIntegrationFixtureStampDir)staging.fingerprint</PluginIntegrationFixtureFingerprintFile>
            <PluginIntegrationFixtureInputList>@(PluginIntegrationFixtureInput->'%(Identity)@%(ModifiedTime)', '|')</PluginIntegrationFixtureInputList>
            <PluginIntegrationFixtureFingerprintPrefix
            >$(Configuration)+$(NETCoreSdkRuntimeIdentifier)+@(PluginIntegrationFixture->'%(StagedName)', '&amp;')+$([MSBuild]::StableStringHash($(PluginIntegrationFixtureInputList)))</PluginIntegrationFixtureFingerprintPrefix>
        </PropertyGroup>

        <ItemGroup Condition="Exists('$(PluginIntegrationFixtureStageRoot)')">
            <PluginIntegrationFixtureStagedFile Include="$(PluginIntegrationFixtureStageRoot)**/*" />
        </ItemGroup>

        <PropertyGroup>
            <PluginIntegrationFixtureStagedList>@(PluginIntegrationFixtureStagedFile->'%(RecursiveDir)%(Filename)%(Extension)', '|')</PluginIntegrationFixtureStagedList>
            <PluginIntegrationFixtureFingerprint
            >$(PluginIntegrationFixtureFingerprintPrefix)+$([MSBuild]::StableStringHash($(PluginIntegrationFixtureStagedList)))</PluginIntegrationFixtureFingerprint>
        </PropertyGroup>

        <ReadLinesFromFile
            File="$(PluginIntegrationFixtureFingerprintFile)"
            Condition="Exists('$(PluginIntegrationFixtureFingerprintFile)')"
        >
            <Output TaskParameter="Lines" ItemName="PluginIntegrationFixturePreviousLine" />
        </ReadLinesFromFile>

        <PropertyGroup>
            <PluginIntegrationFixturePrevious>@(PluginIntegrationFixturePreviousLine)</PluginIntegrationFixturePrevious>
            <PluginIntegrationFixtureStale
                Condition="'$(PluginIntegrationFixturePrevious)' != '$(PluginIntegrationFixtureFingerprint)'"
            >true</PluginIntegrationFixtureStale>
        </PropertyGroup>

        <!--
            Removed wholesale rather than patched, so a file dropped from a fixture's closure cannot
            survive as a leftover: dotnet publish overwrites what it produces and removes nothing it no
            longer produces. The path is composed from OutDir and a literal, so it is always inside this
            project's own output.
        -->
        <RemoveDir
            Directories="$(PluginIntegrationFixtureStageRoot)"
            Condition="'$(PluginIntegrationFixtureStale)' == 'true' AND '$(PluginIntegrationFixtureStageRoot)' != '' AND Exists('$(PluginIntegrationFixtureStageRoot)')"
        />
        <Delete
            Files="$(PluginIntegrationFixtureFingerprintFile)"
            Condition="'$(PluginIntegrationFixtureStale)' == 'true'"
        />
    </Target>

    <Target
        Name="PublishPluginIntegrationFixtures"
        AfterTargets="Build"
        DependsOnTargets="PrunePluginIntegrationFixtureStaging"
        Condition="'$(BuildingPluginFixtures)' != 'true' AND '$(DesignTimeBuild)' != 'true'"
        Inputs="@(PluginIntegrationFixtureInput)"
        Outputs="$(PluginIntegrationFixtureFingerprintFile)"
    >
        <RemoveDir
            Directories="@(PluginIntegrationFixture->'$(PluginIntegrationFixtureStageRoot)%(StagedName)')"
            Condition="'$(PluginIntegrationFixtureStageRoot)' != ''"
        />

        <!--
            BuildingPluginFixtures is passed down so an inner publish can never re-enter this target, and
            the fixture project is named explicitly so nothing walks back up to this test project. No
            runtime identifier, deliberately: a runtime-specific publish restores its project references
            with that identifier too, and NuGet then rewrites their committed lock files.
        -->
        <Exec
            Command="&quot;$(DOTNET_HOST_PATH)&quot; publish &quot;%(PluginIntegrationFixture.FullPath)&quot; --configuration $(Configuration) --no-self-contained --output &quot;$(PluginIntegrationFixtureStageRoot)%(PluginIntegrationFixture.StagedName)&quot; -p:BuildingPluginFixtures=true --nologo --verbosity quiet"
            EnvironmentVariables="DOTNET_CLI_DO_NOT_USE_MSBUILD_SERVER=1;MSBUILDDISABLENODEREUSE=1"
            WorkingDirectory="$(MSBuildThisFileDirectory)"
        />

        <ItemGroup>
            <PluginIntegrationFixtureStagedAfterPublish Include="$(PluginIntegrationFixtureStageRoot)**/*" />
        </ItemGroup>

        <PropertyGroup>
            <PluginIntegrationFixtureStagedListAfterPublish>@(PluginIntegrationFixtureStagedAfterPublish->'%(RecursiveDir)%(Filename)%(Extension)', '|')</PluginIntegrationFixtureStagedListAfterPublish>
            <PluginIntegrationFixtureFingerprintAfterPublish
            >$(PluginIntegrationFixtureFingerprintPrefix)+$([MSBuild]::StableStringHash($(PluginIntegrationFixtureStagedListAfterPublish)))</PluginIntegrationFixtureFingerprintAfterPublish>
        </PropertyGroup>

        <MakeDir Directories="$(PluginIntegrationFixtureStampDir)" />
        <WriteLinesToFile
            File="$(PluginIntegrationFixtureFingerprintFile)"
            Lines="$(PluginIntegrationFixtureFingerprintAfterPublish)"
            Overwrite="true"
            WriteOnlyWhenDifferent="true"
        />
    </Target>
</Project>

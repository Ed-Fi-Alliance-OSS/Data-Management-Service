<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Confluent.Kafka" />
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Microsoft.Data.SqlClient" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Npgsql" />
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NUnit" />
        <PackageReference Include="NUnit.Analyzers" />
        <PackageReference Include="NUnit3TestAdapter" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\EdFi.DataManagementService.Backend.Cdc\EdFi.DataManagementService.Backend.Cdc.csproj" />
        <ProjectReference Include="../EdFi.DataManagementService.Backend.Cdc.Control/EdFi.DataManagementService.Backend.Cdc.Control.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- The CDC control plane's broker-backed fixture reuses this project's Docker CLI, mapped-port,
             and output-redaction helpers rather than standing up a second copy of them. -->
        <InternalsVisibleTo Include="EdFi.DataManagementService.Backend.Cdc.Control.Tests.Integration" />
    </ItemGroup>
    <Import Project="../Fixtures/cdc/message-contract/MessageContractFixtures.props" />
    <ItemGroup>
        <None
            Update="MessageContractRunner/**/*"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
        />
    </ItemGroup>
    <ItemGroup>
        <!-- Share test-only fixture helpers without referencing another test assembly. -->
        <Compile
            Include="../EdFi.DataManagementService.Backend.Cdc.Tests.Unit/MessageContractTraceabilityTests.cs"
            Link="MessageContractTraceabilityTests.cs"
        />
        <Compile
            Include="../EdFi.DataManagementService.Backend.Cdc.Tests.Unit/MessageContractAdmissionFixture.cs"
            Link="MessageContractAdmissionFixture.cs"
        />
        <Compile
            Include="../EdFi.DataManagementService.Backend.Cdc.Tests.Unit/MessageContractFixtureCatalog.cs"
            Link="MessageContractFixtureCatalog.cs"
        />
        <Compile
            Include="../EdFi.DataManagementService.Backend.Cdc.Tests.Unit/MessageContractConsumer.cs"
            Link="MessageContractConsumer.cs"
        />
        <Compile
            Include="../EdFi.DataManagementService.Backend.Cdc.Tests.Unit/MessageContractConsumerBootstrap.cs"
            Link="MessageContractConsumerBootstrap.cs"
        />
        <Compile
            Include="../EdFi.DataManagementService.Backend.Cdc.Tests.Unit/MessageContractJson.cs"
            Link="MessageContractJson.cs"
        />
    </ItemGroup>
</Project>

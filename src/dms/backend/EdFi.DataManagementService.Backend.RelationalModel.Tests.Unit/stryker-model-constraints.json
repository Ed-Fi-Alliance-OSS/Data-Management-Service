{
  "stryker-config": {
    "solution": "../../EdFi.DataManagementService.sln",
    "project": "EdFi.DataManagementService.Backend.RelationalModel.csproj",
    "configuration": "Release",
    "target-framework": "net10.0",
    "test-runner": "vstest",
    "mutation-level": "Standard",
    "coverage-analysis": "perTest",
    "reporters": [
      "html",
      "json",
      "progress"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "SetPasses/KeyUnificationPass.cs",
      "SetPasses/ReferenceConstraintPass.cs",
      "SetPasses/TransitiveIdentityMutabilityPass.cs",
      "SetPasses/ValidateForeignKeyStorageInvariantPass.cs",
      "Schema/JsonSchemaRequirednessConventions.cs",
      "!**/Properties/AssemblyInfo.cs",
      "!**/bin/**",
      "!**/obj/**"
    ]
  }
}

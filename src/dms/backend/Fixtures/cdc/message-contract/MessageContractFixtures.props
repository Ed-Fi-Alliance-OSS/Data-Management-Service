<Project>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)**/*.json"
             Link="Fixtures/cdc/message-contract/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)../../document-cache/materialized-documents/**/expected-*.json"
             Link="Fixtures/document-cache/materialized-documents/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

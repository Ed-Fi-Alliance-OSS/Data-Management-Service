    "headers": {
      "CacheControl": {
        "description": "Every identity operation response is not cacheable by a shared or private HTTP cache (RFC 9111 5.2.2.5).",
        "schema": {
          "type": "string",
          "enum": [
            "no-store"
          ]
        }
      },
      "Location": {
        "description": "The poll URL for retrieving the result of a previously accepted asynchronous identity request.",
        "schema": {
          "type": "string",
          "format": "uri"
        }
      },
      "RetryAfter": {
        "description": "The number of seconds to wait before retrying, present only when the rate limiter supplies it.",
        "schema": {
          "type": "integer"
        }
      }
    },
    "responses": {
      "Identity400": {
        "description": "The request data was invalid, either failing core schema validation or the identity provider's own InvalidProperties diagnosis.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            },
            "examples": {
              "createFieldError": {
                "summary": "A create request field failure, keyed by its JSONPath.",
                "value": {
                  "detail": "Data validation failed. See 'validationErrors' for details.",
                  "type": "urn:ed-fi:api:bad-request:data-validation-failed",
                  "title": "Data Validation Failed",
                  "status": 400,
                  "correlationId": "0HNOOQ2BHB6VR",
                  "validationErrors": {
                    "$.firstName": [
                      "First name is required."
                    ]
                  },
                  "errors": []
                }
              },
              "searchItemError": {
                "summary": "A search batch item failure, keyed by its zero-based JSONPath array index.",
                "value": {
                  "detail": "Data validation failed. See 'validationErrors' for details.",
                  "type": "urn:ed-fi:api:bad-request:data-validation-failed",
                  "title": "Data Validation Failed",
                  "status": 400,
                  "correlationId": "0HNOOQ2BHB6VR",
                  "validationErrors": {
                    "$[2].firstName": [
                      "First name is required for item 2."
                    ]
                  },
                  "errors": []
                }
              },
              "pathlessError": {
                "summary": "A provider error with no associated path, appended to the document-level errors collection.",
                "value": {
                  "detail": "The request could not be processed. See 'errors' for details.",
                  "type": "urn:ed-fi:api:bad-request",
                  "title": "Bad Request",
                  "status": 400,
                  "correlationId": "0HNOOQ2BHB6VR",
                  "validationErrors": {},
                  "errors": [
                    "The request could not be evaluated."
                  ]
                }
              },
              "twoMessagesOneKey": {
                "summary": "Two provider error messages for the same path, grouped under one validationErrors key.",
                "value": {
                  "detail": "Data validation failed. See 'validationErrors' for details.",
                  "type": "urn:ed-fi:api:bad-request:data-validation-failed",
                  "title": "Data Validation Failed",
                  "status": 400,
                  "correlationId": "0HNOOQ2BHB6VR",
                  "validationErrors": {
                    "$.firstName": [
                      "First name is required.",
                      "First name must not exceed 75 characters."
                    ]
                  },
                  "errors": []
                }
              }
            }
          }
        }
      },
      "Identity415": {
        "description": "The request's Content-Type is not application/json or text/json.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/CacheControl"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            },
            "examples": {
              "unsupportedMediaType": {

              "type": {
                "type": "string",
                "enum": [
                  "urn:ed-fi:api:identities:operation-not-supported"
                ]
              }
            }
          }
        ]
      },
      "IdentityNotFoundProblemDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",

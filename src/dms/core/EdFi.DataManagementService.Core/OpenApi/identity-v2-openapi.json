{
  "openapi": "3.0.1",
  "info": {
    "title": "Identity API Endpoints",
    "version": "2"
  },
  "paths": {
    "/identities": {
      "post": {
        "operationId": "createIdentity",
        "summary": "Creates a new identity",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentityCreateRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentityCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The identity was created. The response body is the new UniqueId as a JSON string; no Location header is returned.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                },
                "example": "604700123"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Identity400"
          },
          "415": {
            "$ref": "#/components/responses/Identity415"
          },
          "404": {
            "$ref": "#/components/responses/Identity404"
          },
          "502": {
            "$ref": "#/components/responses/Identity502"
          },
          "500": {
            "$ref": "#/components/responses/Identity500"
          },
          "429": {
            "$ref": "#/components/responses/Identity429"
          }
        }
      }
    },
    "/identities/{id}": {
      "get": {
        "operationId": "getIdentityById",
        "summary": "Retrieves an identity by UniqueId",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The UniqueId of the identity to retrieve.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The identity matching the supplied UniqueId.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityResponse"
                },
                "example": {
                  "UniqueId": "604700123",
                  "LastSurname": "Vasquez",
                  "FirstName": "Sofia",
                  "MiddleName": null,
                  "GenerationCodeSuffix": null,
                  "SexType": "Female",
                  "BirthDate": "2011-05-02T00:00:00Z",
                  "BirthOrder": 1,
                  "BirthLocation": {
                    "City": "Austin",
                    "StateAbbreviation": "TX",
                    "InternationalProvince": null,
                    "Country": "US"
                  },
                  "Score": null
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Identity400"
          },
          "404": {
            "$ref": "#/components/responses/Identity404"
          },
          "502": {
            "$ref": "#/components/responses/Identity502"
          },
          "500": {
            "$ref": "#/components/responses/Identity500"
          },
          "429": {
            "$ref": "#/components/responses/Identity429"
          }
        }
      }
    },
    "/identities/find": {
      "post": {
        "operationId": "findIdentities",
        "summary": "Finds identities matching one or more submitted UniqueIds",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "text/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The synchronous, complete result of the request.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentitySearchResponseComplete"
                },
                "examples": {
                  "complete": {
                    "summary": "A completed synchronous result with one match and one no-match entry.",
                    "value": {
                      "Status": "Complete",
                      "SearchResponses": [
                        {
                          "Responses": [
                            {
                              "UniqueId": "604700123",
                              "LastSurname": "Vasquez",
                              "FirstName": "Sofia",
                              "MiddleName": null,
                              "GenerationCodeSuffix": null,
                              "SexType": "Female",
                              "BirthDate": "2011-05-02T00:00:00Z",
                              "BirthOrder": 1,
                              "BirthLocation": {
                                "City": "Austin",
                                "StateAbbreviation": "TX",
                                "InternationalProvince": null,
                                "Country": "US"
                              },
                              "Score": 92.5
                            }
                          ]
                        },
                        {
                          "Responses": []
                        }
                      ]
                    }
                  },
                  "noMatch": {
                    "summary": "A completed synchronous result with no matching identity for any submitted entry.",
                    "value": {
                      "Status": "Complete",
                      "SearchResponses": [
                        {
                          "Responses": []
                        },
                        {
                          "Responses": []
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "The request was accepted for asynchronous processing. Poll Location for the result.",
            "headers": {
              "Location": {
                "required": true,
                "description": "The poll URL for retrieving the result of this accepted asynchronous identity request.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Identity400"
          },
          "415": {
            "$ref": "#/components/responses/Identity415"
          },
          "404": {
            "$ref": "#/components/responses/Identity404"
          },
          "502": {
            "$ref": "#/components/responses/Identity502"
          },
          "500": {
            "$ref": "#/components/responses/Identity500"
          },
          "429": {
            "$ref": "#/components/responses/Identity429"
          }
        }
      }
    },
    "/identities/search": {
      "post": {
        "operationId": "searchIdentities",
        "summary": "Searches for identities matching one or more submitted demographic requests",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/IdentitySearchRequest"
                }
              }
            },
            "text/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/IdentitySearchRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The synchronous, complete result of the request.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentitySearchResponseComplete"
                },
                "examples": {
                  "complete": {
                    "summary": "A completed synchronous result with one match and one no-match entry.",
                    "value": {
                      "Status": "Complete",
                      "SearchResponses": [
                        {
                          "Responses": [
                            {
                              "UniqueId": "604700123",
                              "LastSurname": "Vasquez",
                              "FirstName": "Sofia",
                              "MiddleName": null,
                              "GenerationCodeSuffix": null,
                              "SexType": "Female",
                              "BirthDate": "2011-05-02T00:00:00Z",
                              "BirthOrder": 1,
                              "BirthLocation": {
                                "City": "Austin",
                                "StateAbbreviation": "TX",
                                "InternationalProvince": null,
                                "Country": "US"
                              },
                              "Score": 92.5
                            }
                          ]
                        },
                        {
                          "Responses": []
                        }
                      ]
                    }
                  },
                  "noMatch": {
                    "summary": "A completed synchronous result with no matching identity for any submitted entry.",
                    "value": {
                      "Status": "Complete",
                      "SearchResponses": [
                        {
                          "Responses": []
                        },
                        {
                          "Responses": []
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "The request was accepted for asynchronous processing. Poll Location for the result.",
            "headers": {
              "Location": {
                "required": true,
                "description": "The poll URL for retrieving the result of this accepted asynchronous identity request.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Identity400"
          },
          "415": {
            "$ref": "#/components/responses/Identity415"
          },
          "404": {
            "$ref": "#/components/responses/Identity404"
          },
          "502": {
            "$ref": "#/components/responses/Identity502"
          },
          "500": {
            "$ref": "#/components/responses/Identity500"
          },
          "429": {
            "$ref": "#/components/responses/Identity429"
          }
        }
      }
    },
    "/identities/results/{id}": {
      "get": {
        "operationId": "getIdentityResults",
        "summary": "Retrieves the result of a previously accepted asynchronous find or search job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The request token returned by the accepted asynchronous find or search job.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The current state of a previously accepted asynchronous find or search job. Location is present only while the job is still Incomplete.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Location": {
                "$ref": "#/components/headers/Location"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/IdentitySearchResponseComplete"
                    },
                    {
                      "$ref": "#/components/schemas/IdentitySearchResponseIncomplete"
                    }
                  ]
                },
                "examples": {
                  "complete": {
                    "summary": "The job completed; SearchResponses carries the final result.",
                    "value": {
                      "Status": "Complete",
                      "SearchResponses": [
                        {
                          "Responses": [
                            {
                              "UniqueId": "604700123",
                              "LastSurname": "Vasquez",
                              "FirstName": "Sofia",
                              "MiddleName": null,
                              "GenerationCodeSuffix": null,
                              "SexType": "Female",
                              "BirthDate": "2011-05-02T00:00:00Z",
                              "BirthOrder": 1,
                              "BirthLocation": {
                                "City": "Austin",
                                "StateAbbreviation": "TX",
                                "InternationalProvince": null,
                                "Country": "US"
                              },
                              "Score": 92.5
                            }
                          ]
                        },
                        {
                          "Responses": []
                        }
                      ]
                    }
                  },
                  "incomplete": {
                    "summary": "The job is still running; SearchResponses is not yet present.",
                    "value": {
                      "Status": "Incomplete"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Identity400"
          },
          "404": {
            "$ref": "#/components/responses/Identity404"
          },
          "502": {
            "$ref": "#/components/responses/Identity502Results"
          },
          "500": {
            "$ref": "#/components/responses/Identity500"
          },
          "429": {
            "$ref": "#/components/responses/Identity429"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IdentityCreateRequest": {
        "type": "object",
        "properties": {
          "LastSurname": {
            "type": "string",
            "nullable": true
          },
          "FirstName": {
            "type": "string",
            "nullable": true
          },
          "MiddleName": {
            "type": "string",
            "nullable": true
          },
          "GenerationCodeSuffix": {
            "type": "string",
            "nullable": true
          },
          "SexType": {
            "type": "string",
            "nullable": true
          },
          "BirthDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "BirthOrder": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "BirthLocation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Location"
              }
            ],
            "nullable": true
          }
        },
        "additionalProperties": true
      },
      "IdentitySearchRequest": {
        "type": "object",
        "properties": {
          "LastSurname": {
            "type": "string",
            "nullable": true
          },
          "FirstName": {
            "type": "string",
            "nullable": true
          },
          "MiddleName": {
            "type": "string",
            "nullable": true
          },
          "GenerationCodeSuffix": {
            "type": "string",
            "nullable": true
          },
          "SexType": {
            "type": "string",
            "nullable": true
          },
          "BirthDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "BirthOrder": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "BirthLocation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Location"
              }
            ],
            "nullable": true
          }
        },
        "additionalProperties": true
      },
      "Location": {
        "type": "object",
        "properties": {
          "City": {
            "type": "string",
            "nullable": true
          },
          "StateAbbreviation": {
            "type": "string",
            "nullable": true
          },
          "InternationalProvince": {
            "type": "string",
            "nullable": true
          },
          "Country": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": true
      },
      "IdentityResponse": {
        "type": "object",
        "properties": {
          "UniqueId": {
            "type": "string",
            "minLength": 1
          },
          "LastSurname": {
            "type": "string",
            "nullable": true
          },
          "FirstName": {
            "type": "string",
            "nullable": true
          },
          "MiddleName": {
            "type": "string",
            "nullable": true
          },
          "GenerationCodeSuffix": {
            "type": "string",
            "nullable": true
          },
          "SexType": {
            "type": "string",
            "nullable": true
          },
          "BirthDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "BirthOrder": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "BirthLocation": {
            "$ref": "#/components/schemas/Location"
          },
          "Score": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "required": [
          "UniqueId",
          "LastSurname",
          "FirstName",
          "MiddleName",
          "GenerationCodeSuffix",
          "SexType",
          "BirthDate",
          "BirthOrder",
          "BirthLocation",
          "Score"
        ],
        "additionalProperties": true
      },
      "IdentitySearchResponses": {
        "type": "object",
        "properties": {
          "Responses": {
            "type": "array",

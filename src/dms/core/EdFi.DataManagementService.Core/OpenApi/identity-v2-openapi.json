        },
        "required": [
          "Status"
        ],
        "additionalProperties": true
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "correlationId": {
            "type": "string"
          },
          "validationErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "detail",
          "type",
          "title",
          "status",
          "correlationId"
        ]
      },
      "IdentityOperationNotSupportedProblemDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProblemDetails"

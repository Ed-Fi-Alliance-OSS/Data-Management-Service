{
  "stryker-config": {
    "solution": "../../EdFi.DataManagementService.sln",
    "project": "EdFi.DataManagementService.Core.csproj",
    "configuration": "Release",
    "target-framework": "net10.0",
    "test-runner": "vstest",
    "mutation-level": "Standard",
    "coverage-analysis": "perTest",
    "reporters": ["html", "json", "progress"],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "Middleware/ResourceActionAuthorizationMiddleware.cs",
      "Middleware/ProvideAuthorizationFiltersMiddleware.cs",
      "Security/ClaimSetResolver.cs",
      "!**/Properties/AssemblyInfo.cs",
      "!**/bin/**",
      "!**/obj/**"
    ]
  }
}

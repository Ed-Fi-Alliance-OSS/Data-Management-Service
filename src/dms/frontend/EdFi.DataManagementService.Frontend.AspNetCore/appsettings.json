{
  "AllowedHosts": "*",
  "AppSettings": {
    "AllowIdentityUpdateOverrides": "",
    "ApiSchemaPath": "",
    "AuthenticationService": "http://localhost:5126/connect/token",
    "BypassTypeCoercion": false,
    "CorrelationIdHeader": "",
    "Datastore": "postgresql",
    "DefaultPartitionCount": 10,
    "DomainsExcludedFromOpenApi": "",
    "EnableClaimsetReload": false,
    "EnableManagementEndpoints": false,
    "MaskRequestBodyInLogs": true,
    "MaximumPageSize": 500,
    "MaxRequestBodySizeMegabytes": 10,
    "PathBase": "",
    "RouteQualifierSegments": "",
    "UseApiSchemaPath": false,
    "UseLegacyDocumentIdOrderingForChangeQueries": false,
    "ReverseProxy": {
      "UseForwardedHeaders": false,
      "KnownProxies": "",
      "KnownNetworks": ""
    },
    "MultiTenancy": false
  },
  "CircuitBreaker": {
    "BreakDurationSeconds": 30,
    "FailureRatio": 0.1,
    "MinimumThroughput": 20,
    "SamplingDurationSeconds": 120
  },
  "DeadlockRetry": {
    "MaxRetryAttempts": 3,
    "BaseDelayMilliseconds": 150,
    "UseJitter": true
  },
  "CacheSettings": {
    "ClaimSetsCacheExpirationSeconds": 600,
    "ApplicationContextCacheExpirationSeconds": 600,
    "TokenCacheExpirationSeconds": 1500,
    "ProfileCacheExpirationSeconds": 1800,
    "DataStoreCacheRefreshEnabled": true,
    "DataStoreCacheExpirationSeconds": 600
  },
  "ConfigurationServiceSettings": {
    "BaseUrl": "http://localhost:5126",
    "ClientId": "CMSReadOnlyAccess",
    "ClientSecret": "",
    "Scope": "edfi_admin_api/readonly_access",
    "EncryptionKey": ""
  },
  "Cors": {
    "SwaggerUIOrigin": "http://localhost:8082"
  },
  "DatabaseOptions": {
    "IsolationLevel": "ReadCommitted"
  },
  "DataManagement": {
    "DocumentCache": {
      "DesignReference": "reference/design/backend-redesign/epics/18-document-cache/01-documentcache-configuration-and-target-selection.md",
      "Targets": [],
      "ReadAcceleration": {
        "Enabled": false,
        "DirectFillTimeout": "00:00:00.250"
      },
      "Projector": {
        "PollInterval": "00:00:05",
        "PageSize": 100,
        "MaxConcurrentTargets": 2,
        "FailureBackoff": "00:00:30",
        "BaselineHighWaterMark": 1000
      },
      "Administration": {
        "WorkflowTimeout": "1.00:00:00"
      },
      "Status": {
        "StatusObservationTimeout": "00:00:05",
        "EndpointTimeout": "00:00:30"
      }
    }
  },
  "MappingPacks": {
    "Enabled": false,
    "Required": false,
    "RootPath": null,
    "AllowRuntimeCompileFallback": true,
    "FailureCooldownSeconds": 0,
    "CacheMode": "InMemory"
  },
  "JwtAuthentication": {
    "Audience": "account",
    "Authority": "http://localhost:5126",
    "AutomaticRefreshIntervalHours": 24,
    "ClientRole": "service",
    "ClockSkewSeconds": 30,
    "MetadataAddress": "http://localhost:5126/.well-known/openid-configuration",
    "RefreshIntervalMinutes": 60,
    "RequireHttpsMetadata": false,
    "RoleClaimType": "http://schemas.microsoft.com/ws/2008/06/identity/claims/role"
  },
  "RateLimit": {
    "PermitLimit": 20000,
    "QueueLimit": 0,
    "Window": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console"
    ],
    "WriteTo": [
      {
        "Args": {
          "path": "./logs/.log",
          "rollingInterval": "Day",
          "formatter": {
            "type": "Serilog.Formatting.Json.JsonFormatter, Serilog"
          }
        },
        "Name": "File"
      },
      {
        "Args": {
          "formatter": {
            "type": "Serilog.Formatting.Json.JsonFormatter, Serilog",
            "renderMessage": true
          }
        },
        "Name": "Console"
      }
    ]
  },
  "OtlpLogging": {
    "Enabled": false,
    "Endpoint": "",
    "Protocol": "HttpProtobuf",
    "ServiceName": "EdFi.DataManagementService",
    "Headers": {}
  }
}

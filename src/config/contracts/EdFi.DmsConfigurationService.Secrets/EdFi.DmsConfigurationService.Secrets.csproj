<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="Version;AssemblyVersion;FileVersion;InformationalVersion">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>EdFi.Api.Secrets</PackageId>
        <AssemblyName>EdFi.DmsConfigurationService.Secrets</AssemblyName>
        <RootNamespace>EdFi.DmsConfigurationService.Secrets</RootNamespace>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Ed-Fi-Alliance-OSS/Data-Management-Service</PackageProjectUrl>
        <Title>Ed-Fi API Secrets Contract</Title>
        <Description>Public contracts for resolving named secrets and hashing client secrets in the Ed-Fi DMS Configuration Service.</Description>
        <!--
            The contracts' load-bearing rules (replace cardinality, singleton and unkeyed
            registration, the resolver's caching obligation) live only in /// comments, so the XML
            file has to ship or an implementer's IDE shows them nothing.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!--
            The contract is versioned independently of the Configuration Service release: its
            version has to move when its public surface moves and must not move when it does not.
            Two things would otherwise stamp the release onto it.

            src/config/Directory.Build.props, which build-config.ps1's SetDMSAssemblyInfo
            regenerates with the release version. A csproj property overrides an imported one, so
            declaring these four here is enough for that.

            Global properties, which a csproj declaration alone loses to. build-config.ps1 Compile
            and PublishApi pass /p:Version, /p:InformationalVersion, /p:AssemblyVersion and
            /p:FileVersion on the command line, and a global property reaches every project in the
            solution and every ProjectReference. The TreatAsLocalProperty attribute on the Project
            element above is what lets these declarations win over a global property of the same
            name, so the contract keeps them on a direct solution build, on a build or publish of
            a project that references it, and inside the Docker image, while every other assembly
            still takes the stamped value.

            InformationalVersion is declared because without it the DLL's ProductVersion falls back
            to the props file's release value.
        -->
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
        <InformationalVersion>1.0.0</InformationalVersion>
    </PropertyGroup>
    <!--
        This project declares no PackageReference and no ProjectReference, on purpose: the
        dependency closure an implementer inherits is part of the contract, and every type in these
        signatures resolves out of the shared framework. A host assembly's surface must not ride
        along with a package a third party compiles against.
    -->
</Project>

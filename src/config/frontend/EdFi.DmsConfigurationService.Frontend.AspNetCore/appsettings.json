{
    "AppSettings": {
        "TokenRequestTimeoutSeconds": 30,
        "DeployDatabaseOnStartup": true,
        "Datastore": "postgresql",
        "IdentityProvider": "self-contained",
        "EnableApplicationResetEndpoint": false,
        "PathBase": "",
        "ReverseProxy": {
            "UseForwardedHeaders": false,
            "KnownProxies": "",
            "KnownNetworks": ""
        },
        "MultiTenancy": false,
        "SpecificationVersion": "v3"
    },
    "DatabaseSettings": {
        "DatabaseConnection": "host=localhost;port=5432;username=postgres;database=edfi_configurationservice;",
        "EncryptionKey": ""
    },
    "ApplicationLockSettings": {
        "AcquireTimeout": "00:00:05"
    },
    "JobSettings": {
        "WorkerEnabled": true,
        "SchedulerEnabled": true,
        "RetentionEnabled": true,
        "PollInterval": "00:00:05",
        "LeaseDuration": "00:05:00",
        "RenewalInterval": "00:01:00",
        "FenceTimeout": "00:00:10",
        "MaxAttempts": 5,
        "RetryBackoffBase": "00:00:30",
        "RetryBackoffMaximum": "00:15:00",
        "MaxConcurrentJobs": 2,
        "FinishedJobRetention": "7.00:00:00",
        "RetentionInterval": "01:00:00",
        "RetentionBatchSize": 500
    },
    "ClaimsOptions": {
        "ClaimsSource": "Embedded",
        "ClaimsDirectory": "",
        "DataStandardVersion": "5.2"
    },
    "IdentitySettings": {
        "AllowRegistration": false,
        "ConfigServiceRole": "cms-client",
        "ClientRole": "dms-client",
        "Authority": "http://localhost:5126",
        "Audience": "account",
        "ClientId": "DmsConfigurationService",
        "ClientSecret": "",
        "RequireHttpsMetadata": false,
        "RoleClaimType": "http://schemas.microsoft.com/ws/2008/06/identity/claims/role",
        "EncryptionKey": "",
        "OpenIddictTokenExpirationTimeMinutes": "30",
        "TokenCleanupEnabled": true,
        "TokenCleanupIntervalMinutes": 30,
        "BearerTokenPerClientLimit": 5,
        "UseDevelopmentCertificates": false,
        "MaxKeyCacheSize": 100,
        "ClientSecretHashingIterations": 210000,
        "ClientSecretValidation": {
            "MinimumLength": 32,
            "MaximumLength": 128
        }
    },
    "AllowedHosts": "*",
    "Serilog": {
        "Using": [
            "Serilog.Sinks.File",
            "Serilog.Sinks.Console"
        ],
        "MinimumLevel": {
            "Default": "Information"
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "./logs/.log",
                    "rollingInterval": "Day",
                    "formatter": {
                        "type": "Serilog.Formatting.Json.JsonFormatter, Serilog"
                    }
                }
            },
            {
                "Name": "Console",
                "Args": {
                    "formatter": {
                        "type": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                        "renderMessage": true
                    }
                }
            }
        ]
    },
    "OtlpLogging": {
        "Enabled": false,
        "Endpoint": "",
        "Protocol": "HttpProtobuf",
        "ServiceName": "EdFi.DmsConfigurationService",
        "Headers": {}
    }
}

{
  "stryker-config": {
    "solution": "../../EdFi.DmsConfigurationService.sln",
    "project": "EdFi.DmsConfigurationService.Claims.csproj",
    "configuration": "Release",
    "target-framework": "net10.0",
    "test-runner": "vstest",
    "mutation-level": "Standard",
    "coverage-analysis": "perTest",
    "reporters": ["html", "json", "progress"],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "AuthorizationMetadata/AuthorizationMetadataResolver.cs",
      "AuthorizationMetadata/AuthorizationMetadataResponse.cs",
      "!**/Properties/AssemblyInfo.cs",
      "!**/bin/**",
      "!**/obj/**"
    ]
  }
}

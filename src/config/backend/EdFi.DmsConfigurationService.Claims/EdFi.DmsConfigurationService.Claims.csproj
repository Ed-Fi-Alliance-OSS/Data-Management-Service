<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="EdFi.DmsConfigurationService.Backend.Tests.Unit" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="JsonSchema.Net" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Claims/JsonSchemaForClaims.json" />
    </ItemGroup>
    <ItemGroup>
        <!-- Per-data-standard embedded base claims. Adding a DS version is dropping a
             Claims/Standards/ds<NN>/Claims.json folder; the version is selected at runtime. -->
        <EmbeddedResource Include="Claims/Standards/**/Claims.json" />
    </ItemGroup>
</Project>

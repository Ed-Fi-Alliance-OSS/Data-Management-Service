# -----------------
# Postgres database
# -----------------
POSTGRES_PASSWORD=abcdefgh1!
POSTGRES_DB_NAME=edfi_configurationservice
POSTGRES_PORT=5435

# -----------------
# SQL Server database
# -----------------
# Defined before CONFIGURATION_SERVICE_DATABASE_CONNECTION_STRING below, which interpolates it.
MSSQL_SA_PASSWORD=abcdefgh1!
MSSQL_PORT=1435
MSSQL_MEMORY_LIMIT_MB=4096
MSSQL_AGENT_ENABLED=true
MSSQL_CONTAINER_MEMORY=10g
MSSQL_TMPFS_SIZE=4g
MSSQL_USE_TMPFS=true

# ---
# Identity Provider Configuration
# ---
KEYCLOAK_OAUTH_TOKEN_ENDPOINT=http://localhost:8045/realms/edfi/protocol/openid-connect/token
KEYCLOAK_DMS_JWT_AUTHORITY=http://localhost:8045/realms/edfi
KEYCLOAK_CONFIGURATION_SERVICE_IDENTITY_AUTHORITY=http://dms-keycloak:8080/realms/edfi
KEYCLOAK_DMS_JWT_METADATA_ADDRESS=http://dms-keycloak:8080/realms/edfi/.well-known/openid-configuration

SELF_CONTAINED_OAUTH_TOKEN_ENDPOINT=http://localhost:8081/connect/token
SELF_CONTAINED_DMS_JWT_AUTHORITY=http://ed-fi-api-config:8081
SELF_CONTAINED_DMS_JWT_METADATA_ADDRESS=http://ed-fi-api-config:8081/.well-known/openid-configuration
# --------
# Keycloak
# --------

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8045

# --------------
# Configuration Service
# --------------

CONFIGURATION_SERVICE_ASPNETCORE_HTTP_PORTS=8081
CONFIGURATION_SERVICE_DATASTORE=mssql
CONFIGURATION_SERVICE_DATABASE_CONNECTION_STRING=Server=dms-mssql,1433;Database=${POSTGRES_DB_NAME};User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=true;
CONFIGURATION_SERVICE_DATABASE_ENCRYPTION_KEY=secret!_32_chars_xxxxxxxxxxxxxxx
CONFIGURATION_SERVICE_IDENTITY_ALLOW_REGISTRATION=true
CONFIGURATION_SERVICE_IDENTITY_SERVICE_ROLE=cms-client
CONFIGURATION_SERVICE_IDENTITY_CLIENT_ROLE=dms-client
CONFIGURATION_SERVICE_IDENTITY_AUTHORITY=http://ed-fi-api-config:8081
CONFIGURATION_SERVICE_IDENTITY_AUDIENCE=account
CONFIGURATION_SERVICE_IDENTITY_CLIENT_ID=DmsConfigurationService
CONFIGURATION_SERVICE_IDENTITY_CLIENT_SECRET=ValidClientSecret1234567890!Abcd
CONFIGURATION_SERVICE_IDENTITY_CLIENT_SECRET_MINIMUM_LENGTH=32
CONFIGURATION_SERVICE_IDENTITY_CLIENT_SECRET_MAXIMUM_LENGTH=128
CONFIGURATION_SERVICE_IDENTITY_REQUIRE_HTTPS=false
CONFIGURATION_SERVICE_IDENTITY_ROLE_CLAIM_TYPE=http://schemas.microsoft.com/ws/2008/06/identity/claims/role
CONFIGURATION_SERVICE_LOG_LEVEL=Information
CONFIGURATION_SERVICE_DEPLOY_DATABASE=true
CONFIGURATION_SERVICE_MULTI_TENANCY=true
CONFIGURATION_SERVICE_PATH_BASE=config
CONFIGURATION_SERVICE_USE_REVERSE_PROXY_HEADERS=false
CONFIGURATION_SERVICE_TOKEN_TIMEOUT_SECONDS=30
CONFIGURATION_SERVICE_DANGEROUSLY_ENABLE_UNRESTRICTED_CLAIMS_LOADING=true
CONFIGURATION_SERVICE_CLAIMS_SOURCE=Hybrid
CONFIGURATION_SERVICE_CLAIMS_DIRECTORY=/app/additional-claims
CONFIGURATION_SERVICE_IDENTITY_ENCRYPTION_KEY=QWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXo0NTY3ODkwMTIz
CONFIGURATION_SERVICE_IDENTITY_HASHING_ITERATIONS=210000
CONFIGURATION_SERVICE_IDENTITY_PROVIDER=self-contained
# Default 15 active tokens per ApiClient-backed Ed-Fi API client (self-contained only).
# Exemption requires no live ApiClient row and nonempty registered scopes
# consisting only of recognized Configuration Service admin scopes (case-sensitive).
# Operators may set a value below 1 to disable enforcement globally.
CONFIGURATION_SERVICE_IDENTITY_BEARER_TOKEN_PER_CLIENT_LIMIT=15

# DMS connecting to the Configuration Service
DMS_CONFIGURATION_SERVICE_CLIENT_SECRET=ValidClientSecret1234567890!Abcd

SCHEMA_PACKAGES='[
  {
    "version": "1.0.335",
    "feedUrl": "https://pkgs.dev.azure.com/ed-fi-alliance/Ed-Fi-Alliance-OSS/_packaging/EdFi/nuget/v3/index.json",
    "name": "EdFi.DataStandard52.ApiSchema"
  },
  {
    "version": "1.0.335",
    "feedUrl": "https://pkgs.dev.azure.com/ed-fi-alliance/Ed-Fi-Alliance-OSS/_packaging/EdFi/nuget/v3/index.json",
    "name": "EdFi.DataStandard52.TPDM.ApiSchema"
  },
  {
    "version": "1.0.335",
    "feedUrl": "https://pkgs.dev.azure.com/ed-fi-alliance/Ed-Fi-Alliance-OSS/_packaging/EdFi/nuget/v3/index.json",
    "name": "EdFi.DataStandard52.Sample.ApiSchema",
    "extensionName": "Sample"
  },
  {
    "version": "1.0.335",
    "feedUrl": "https://pkgs.dev.azure.com/ed-fi-alliance/Ed-Fi-Alliance-OSS/_packaging/EdFi/nuget/v3/index.json",
    "name": "EdFi.DataStandard52.Homograph.ApiSchema",
    "extensionName": "Homograph"
  }
]'

DMS_HTTP_PORTS=8080

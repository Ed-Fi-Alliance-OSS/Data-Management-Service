# DocumentCache hosted E2E overlay. Compose this onto .env.e2e only for the focused
# DocumentCacheHostedHappyPath fixture; the shared E2E stack keeps read acceleration disabled.
# Disable DMS data-store cache refresh so host-side admin CLI connection-string swaps cannot be
# observed by the running DMS process.
DMS_DOCUMENTCACHE_COMPOSE_FILE=local-dms-document-cache.yml
DMS_DATASTORE_CACHE_REFRESH_ENABLED=false
DMS_DOCUMENTCACHE_TARGET_TENANT_KEY=
DMS_DOCUMENTCACHE_TARGET_DATA_STORE_ID=1
DMS_DOCUMENTCACHE_READ_ACCELERATION_ENABLED=true
DMS_DOCUMENTCACHE_READ_ACCELERATION_DIRECT_FILL_TIMEOUT=00:00:05
DMS_DOCUMENTCACHE_PROJECTOR_POLL_INTERVAL=00:00:01
DMS_DOCUMENTCACHE_PROJECTOR_PAGE_SIZE=100
DMS_DOCUMENTCACHE_PROJECTOR_MAX_CONCURRENT_TARGETS=1
DMS_DOCUMENTCACHE_PROJECTOR_FAILURE_BACKOFF=00:00:05
DMS_DOCUMENTCACHE_PROJECTOR_BASELINE_HIGH_WATER_MARK=100
DMS_DOCUMENTCACHE_ADMINISTRATION_WORKFLOW_TIMEOUT=00:05:00
DMS_DOCUMENTCACHE_STATUS_OBSERVATION_TIMEOUT=00:00:01
DMS_DOCUMENTCACHE_STATUS_ENDPOINT_TIMEOUT=00:00:10
DMS_DOCUMENTCACHE_STATUS_REQUIRED_ROLE=dms-client

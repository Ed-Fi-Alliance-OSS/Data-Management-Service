<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!--
        Off because this project is compiled only and never shipped or loaded, and the vendor SDKs it
        pins sit outside Dependabot's scope. With the audit on, an advisory published against any of
        them or anything they pull in transitively turns into a restore error (NU1901 to NU1904, by
        severity) under TreatWarningsAsErrors. The prerelease lane compiles this inside pack-secrets, which every
        Configuration Service release waits on through check-secrets-contract and pack-cs, so a
        vendor advisory would block a release that ships none of these packages.
      -->
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <!--
    Declared as properties so Invoke-SecretsConsumerCheck.ps1 can point this at the two versions
    it just packed without editing a tracked file. Neither default is produced by anything, so
    building this project without the runner fails restore rather than quietly succeeding against
    some other copy of either contract. Both are pinned exactly, in [brackets]: a bare version is a
    floor, and with more than one nupkg in the feed NuGet would resolve a different one and only
    warn (NU1603).
  -->
    <PropertyGroup>
        <SecretsPackageVersion Condition="'$(SecretsPackageVersion)' == ''"
            >0.0.0-local</SecretsPackageVersion
        >
        <PluginsPackageVersion Condition="'$(PluginsPackageVersion)' == ''"
            >0.0.0-local</PluginsPackageVersion
        >
    </PropertyGroup>

    <!--
    The worked examples the EdFi.Api.Secrets readme publishes, compiled against the two packed
    contracts and real vendor SDKs, so a sample an implementer copies is one that compiles and a
    vendor API change surfaces here rather than in an implementer's build. Assert-DocumentEmbeds.ps1
    holds the readme's blocks to the regions in these files.

    It is a compile check and nothing more: it is never loaded by a host and never talks to a vault.
    It is a separate project from eng/verification/SecretsConsumer because that one proves the
    contract restores with no dependency at all from nothing but the local feed, and the vendor
    SDKs here would remove the property it exists to hold.

    Outside central package management, in no .sln, and with no ProjectReference into src/. The
    vendor versions below are an implementer's choice and are deliberately independent of
    src/Directory.Packages.props and of Dependabot; they are pinned so that the examples compile
    against a known API rather than whatever is newest on the day. The two Microsoft.Extensions
    abstractions are declared because the examples name their types directly, at the versions the
    vendor SDKs already require, since declaring a lower one is a downgrade restore refuses.
  -->
    <ItemGroup>
        <PackageReference Include="EdFi.Api.Secrets" Version="[$(SecretsPackageVersion)]" />
        <PackageReference Include="EdFi.Api.Plugins" Version="[$(PluginsPackageVersion)]" />
        <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Amazon.Extensions.Configuration.SystemsManager" Version="7.1.1" />
        <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.102.1" />
        <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.0.104.1" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    </ItemGroup>
</Project>

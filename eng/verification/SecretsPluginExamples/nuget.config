<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <!--
            The folder Invoke-SecretsConsumerCheck.ps1 packs EdFi.Api.Secrets and EdFi.Api.Plugins
            into, a fresh path per run, which a committed file cannot name. NuGet expands the
            environment variable, and the runner sets it for the restore. Without the runner it is
            unset and restore fails rather than resolving either contract from somewhere else.
        -->
        <add key="local-verification-feed" value="%SECRETS_VERIFICATION_FEED%" />
        <!--
            The vendor SDKs the examples compile against, and their dependencies. Removing it breaks
            the examples, not the packages.
        -->
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <!--
        Both Ed-Fi ids are mapped to the local feed and everything else to nuget.org, so a package
        published under a matching version can never be validated in place of the one just packed.
        That matters for both: each contract's version is fixed at its own surface version, so the
        published and local versions will routinely be the same string.
    -->
    <packageSourceMapping>
        <packageSource key="local-verification-feed">
            <package pattern="EdFi.Api.Secrets" />
            <package pattern="EdFi.Api.Plugins" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!--
            The repository root, where build-dms.ps1 drops EdFi.Api.CustomValidation's
            nupkg. A relative path so this config works identically from a CI
            checkout at a different absolute path.
        -->
        <add key="local-verification-feed" value="../../../" />
        <!--
            EdFi.Api.CustomValidation itself declares no dependencies, and the per-PR job asserts
            that. This source is here for THIS project's own two PackageReferences
            (Microsoft.Extensions.DependencyInjection.Abstractions and Microsoft.Extensions.Options),
            which an implementer needs to register a validator and which the contract package
            deliberately does not supply. Removing this source breaks the consumer, not the package.
        -->
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <!--
        Without this the id under verification resolves by source order alone: nuget.org is a
        live source for EdFi.Api.CustomValidation, so a package published there under a matching
        version could be validated in place of the one just packed. This is the same
        dependency-confusion window the SchemaTools step in on-dms-pullrequest.yml closes by
        passing an explicit source to `dotnet tool install`. That approach is not usable here: a
        library package does not bundle its closure, so this restore genuinely needs nuget.org.
        The id under verification is mapped to the local feed instead, and everything else to
        nuget.org.
    -->
    <packageSourceMapping>
        <packageSource key="local-verification-feed">
            <package pattern="EdFi.Api.CustomValidation" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>

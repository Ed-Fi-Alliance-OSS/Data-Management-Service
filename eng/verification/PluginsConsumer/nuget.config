<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!--
            The repository root, where build-dms.ps1 drops EdFi.Api.Plugins's nupkg. A
            relative path so this config works identically from a CI checkout at a
            different absolute path.
        -->
        <add key="local-verification-feed" value="../../../" />
        <!--
            EdFi.Api.Plugins declares Microsoft.Extensions.Configuration.Abstractions and
            Microsoft.Extensions.DependencyInjection.Abstractions, and this project declares
            them as well, so both reach restore as ordinary public dependencies that have to
            resolve from somewhere. That is what this source is for. Removing it breaks the
            consumer, not the package.
        -->
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <!--
        Without this the id under verification resolves by source order alone: nuget.org is a
        live source, so once EdFi.Api.Plugins is published there a package of a matching
        version could be validated in place of the one just packed. That window matters more
        here than for the sibling contract, because this package's version is fixed at the
        contract's own surface version rather than moving with every build, so the published
        and local versions will routinely be the same string. The id under verification is
        mapped to the local feed, and everything else to nuget.org.
    -->
    <packageSourceMapping>
        <packageSource key="local-verification-feed">
            <package pattern="EdFi.Api.Plugins" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!--
            The repository root, where build-dms.ps1 drops both EdFi.Api.Identity's and
            EdFi.Api.Plugins's nupkg. A relative path so this config works identically from a CI
            checkout at a different absolute path.
        -->
        <add key="local-verification-feed" value="../../../" />
        <!--
            The Microsoft.Extensions PackageReferences in this project, and anything the two
            contracts declare as public dependencies, have to resolve from somewhere, and neither
            contract package supplies them. That is what this source is for. Removing it breaks
            the consumer, not the packages.
        -->
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <!--
        Without this, the two ids under verification resolve by source order alone: nuget.org is
        a live source, so a package published there under a matching version could be validated
        in place of one just packed. Both Ed-Fi ids are mapped to the local feed explicitly, and
        everything else to nuget.org.

        Both matter: each contract's version is fixed at its own surface version rather than
        moving with every build, so the published and local versions will routinely be the same
        string.
    -->
    <packageSourceMapping>
        <packageSource key="local-verification-feed">
            <package pattern="EdFi.Api.Identity" />
            <package pattern="EdFi.Api.Plugins" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>

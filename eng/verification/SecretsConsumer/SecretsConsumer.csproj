<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!--
    Declared as a property so the lane can point this at the version it just packed
    (-p:SecretsPackageVersion=<v>) without editing a tracked file. Nothing produces this
    default on its own, so building this project without Invoke-SecretsConsumerCheck.ps1
    fails restore rather than quietly succeeding against some other EdFi.Api.Secrets.

    Pinned exactly, in [brackets]: a bare version is a floor, and with more than one nupkg
    in the feed NuGet would resolve a different one and only warn (NU1603).
  -->
    <PropertyGroup>
        <SecretsPackageVersion Condition="'$(SecretsPackageVersion)' == ''"
            >0.0.0-local</SecretsPackageVersion
        >
    </PropertyGroup>

    <!--
    Outside central package management and outside every .sln, with no ProjectReference into
    src/: this project proves EdFi.Api.Secrets restores and compiles the way an outside
    implementer experiences it. The contract declares no dependencies and this project needs
    none of its own, so the only package it restores is the one under verification (see
    nuget.config).
  -->
    <ItemGroup>
        <PackageReference Include="EdFi.Api.Secrets" Version="[$(SecretsPackageVersion)]" />
    </ItemGroup>
</Project>

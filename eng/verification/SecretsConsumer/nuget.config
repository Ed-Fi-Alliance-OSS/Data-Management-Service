<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!--
        No package source at all. Invoke-SecretsConsumerCheck.ps1 restores with an explicit
        source pointing at the folder it just packed EdFi.Api.Secrets into, and that is the only
        source this project may see. EdFi.Api.Secrets declares no dependencies and this project
        references nothing else, so no public feed is needed, and leaving none configured means a
        package published under a matching version can never be validated in place of the one
        just packed.
    -->
    <packageSources>
        <clear />
    </packageSources>
</configuration>

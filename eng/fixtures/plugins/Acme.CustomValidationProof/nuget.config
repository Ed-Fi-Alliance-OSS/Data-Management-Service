<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <!--
            Where the staging target drops the two freshly packed contract nupkgs. A relative path,
            so this works identically from a checkout at any absolute path, and a path that does not
            vary by configuration, because a nuget.config cannot expand an MSBuild property. The
            configuration is carried in the package version instead, so a Debug and a Release build
            write different files into this one folder and never race.
        -->
        <add key="local-fixture-feed" value="../.local-feed" />
        <!--
            Both contracts declare public dependencies that have to resolve from somewhere, and this
            project declares two of them itself.
        -->
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <!--
        Without this the two ids under test resolve by source order alone, so once either is
        published a package of a matching version could be restored in place of the one just packed.
        Both are mapped to the local feed and everything else to nuget.org.
    -->
    <packageSourceMapping>
        <packageSource key="local-fixture-feed">
            <package pattern="EdFi.Api.Plugins" />
            <package pattern="EdFi.Api.CustomValidation" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
